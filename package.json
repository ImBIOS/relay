{
  "name": "relay",
  "description": "CLI for managing AI API providers — switch, rotate, track usage across Z.AI, MiniMax, and more",
  "version": "2.1.0",
  "author": {
    "name": "Imamuzzaki Abu Salam",
    "email": "imamuzzaki@gmail.com",
    "url": "https://github.com/ImBIOS"
  },
  "bin": {
    "relay": "./src/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "@anthropic-ai/sdk": "^0.72.1",
    "@clack/prompts": "^1.3.0",
    "@imbios/forgecode-sdk": "file:../../submodules/forgecode-sdk",
    "@oclif/core": "^4.8.0",
    "jsonc": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.5.0",
    "@types/bun": "^1.3.12",
    "@types/node": "^24.10.1"
  },
  "exports": {
    ".": "./src/oclif/base.tsx",
    "./sdk": "./src/sdk/index.ts"
  },
  "keywords": [
    "anthropic",
    "api",
    "claude-code",
    "cli",
    "glm",
    "minimax",
    "opencode",
    "provider",
    "proxy",
    "rotation"
  ],
  "oclif": {
    "bin": "relay",
    "commands": {
      "glob": "**/*.tsx",
      "strategy": "pattern",
      "target": "./src/commands"
    },
    "default": "help",
    "dirname": "relay",
    "flexibleTaxonomy": true,
    "topicSeparator": " ",
    "topics": {
      "account": {
        "description": "Multi-account management"
      },
      "auto": {
        "description": "Cross-provider auto-rotation"
      },
      "hooks": {
        "description": "Claude Code / ForgeCode hook management"
      },
      "proxy": {
        "description": "Anthropic API proxy server for hot-switching providers"
      }
    }
  },
  "scripts": {
    "build": "bun build src/run.ts --outfile=bin/relay.bundled.js --target=node --packages=external",
    "check": "oxlint . && oxfmt --check src/",
    "check:fix": "oxlint . --fix && oxfmt --write src/",
    "dev": "bun --hot src/run.ts",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "bun tsc --noEmit --skipLibCheck"
  },
  "type": "module"
}
